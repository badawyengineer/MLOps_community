# =============================================================================
# prodml - environment variables.   Copy to .env and edit:   cp .env.example .env
#
# * .env is git-ignored. NEVER commit real keys; this file holds names and safe placeholders only.
# * EVERY variable here is OPTIONAL. With none set, the service runs fully offline: real retrieval over the
#   bundled Civil Code corpus, extractive (quoted) answers, no LLM, no tracing, no account of any kind.
# * Validate your setup at any time:   prodml-doctor            (offline checks)
#                                      prodml-doctor --online   (also probes the services you configured)
# * Values in the real environment override this file. Invalid values stop startup with a message naming the variable.
# =============================================================================

# --- Corpus / data (paths are relative to the repository root) ---------------
# PRODML_CORPUS_PATH=data/processed/articles.json     # committed corpus: 1,149 articles
# PRODML_RAW_PDF_PATH=data/raw/egyptian_civil_code.pdf  # only needed to REBUILD the corpus (prodml-ingest / dvc repro)
# PRODML_REPEALED_RANGES=54-80,389-417                # ranges flagged as repealed (the PDF's own notes are merged in)
# PRODML_DRIFT_BASELINE_PATH=data/eval/questions.json # eval set, also the query-drift baseline

# --- Retrieval ---------------------------------------------------------------
# PRODML_RETRIEVER=hybrid-dense      # tfidf | bm25 | hybrid | vector | hybrid-dense | embedding
# PRODML_EMBEDDING_MODEL=hashing-1024  # hashing[-DIM] | lsa[-DIM] (offline)  |  <org>/<model>, e.g. intfloat/multilingual-e5-small
#                                      #   (downloads from huggingface.co on first use; needs `pip install -e ".[embeddings]"`)
# PRODML_INDEX_DIR=data/index
# PRODML_CHUNK_CHARS=0               # 0 = one chunk per article (what citations want)
# PRODML_CHUNK_OVERLAP=0
# PRODML_TOP_K=3
# PRODML_MIN_CONFIDENCE=0.3          # abstain below this top score (0-1); re-tune with prodml-eval --sweep after changing the embedder
# PRODML_MAX_CONTEXT_CHARS=4000

# --- API service -------------------------------------------------------------
# PRODML_HOST=0.0.0.0
# PRODML_PORT=8000
# PRODML_LOG_LEVEL=INFO              # CRITICAL | ERROR | WARNING | INFO | DEBUG
# PRODML_MODEL_VERSION=0.1.0         # echoed in every response

# --- Answer generation -------------------------------------------------------
# extractive (default): quotes the retrieved articles. No LLM, no key, fully offline.
# vllm | api: an OpenAI-compatible chat endpoint (vLLM on a GPU, a hosted API, or `prodml-mock-llm` for a no-GPU
#             MOCK that only exercises the code path - its answers are labelled and are NOT model output).
PRODML_GENERATION_BACKEND=extractive
# PRODML_LLM_BASE_URL=http://localhost:8001/v1   # required with vllm/api
# PRODML_LLM_MODEL=                              # required with vllm/api, e.g. Qwen/Qwen2.5-1.5B-Instruct (or the mock's --model)
# PRODML_LLM_API_KEY=                            # SECRET. Needed only by hosted APIs; self-hosted vLLM and the mock need none
# PRODML_LLM_TIMEOUT=30
# PRODML_LLM_MAX_TOKENS=400
# PRODML_LLM_PRICE_IN_PER_1K=0       # USD per 1k prompt tokens, for the Grafana cost panel (0 = self-hosted / unknown)
# PRODML_LLM_PRICE_OUT_PER_1K=0

# --- Tracing (optional; set all three or none) ---------------------------------
# PRODML_LANGFUSE_HOST=http://localhost:3000     # self-hosted Langfuse or https://cloud.langfuse.com
# PRODML_LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
# PRODML_LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME    # SECRET

# --- Experiment tracking (MLflow). Read straight from the environment by prodml-eval / -monitor / -experiments ---
# MLFLOW_TRACKING_URI=               # unset = local sqlite file ./mlflow.db (+ ./mlruns). Or http://localhost:5000 for a server
# PRODML_MLFLOW_ARTIFACTS=           # optional artifact location override

# --- Real RAGAS faithfulness (optional, COSTS MONEY; the default lexical proxy needs nothing) ---------------------
# OPENAI_API_KEY=                    # SECRET. Judge LLM used by `prodml-monitor --ragas` (pip install -e ".[ragas]")

# --- Hugging Face downloads (only for PRODML_EMBEDDING_MODEL=<org>/<model> or the GPU notebook) ---------------
# HF_HOME=                           # model cache directory (default ~/.cache/huggingface)
# HF_TOKEN=                          # SECRET. Only for gated/private models; the models used here are public

# --- docker compose (docker/docker-compose*.yml). Pass this file explicitly, compose looks in docker/ by default:
#       docker compose --env-file .env -f docker/docker-compose.yml up --build
# Grafana's admin password is hard-coded to admin/admin in the compose file: local demo only, never expose port 3001.

# --- NOT read from .env: GitHub Actions repository secrets (Settings -> Secrets and variables -> Actions) --------
#   DOCKERHUB_USERNAME, DOCKERHUB_TOKEN   publish the image on pushes to main (skipped, with a notice, when absent)
#   OPENAI_API_KEY                        enables the optional real-RAGAS workflow (.github/workflows/monitor.yml)
# --- NOT read from .env: Kaggle notebook secrets (notebooks/kaggle_gpu_run.ipynb) ----------------------------------
#   GH_TOKEN (only if the repo were private), OPENAI_API_KEY (only with RUN_RAGAS = True)
