{
 "uid": "legal-qa",
 "title": "Legal QA - RAG health",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request rate (/ask)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(prodml_requests_total{path=\"/ask\"}[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Latency p50 / p95 (/ask)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "B",
     "expr": "histogram_quantile(0.5, sum(rate(prodml_request_latency_seconds_bucket{path=\"/ask\"}[5m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(prodml_request_latency_seconds_bucket{path=\"/ask\"}[5m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Abstention rate",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(prodml_abstentions_total[5m]) / clamp_min(sum(rate(prodml_requests_total{path=\"/ask\"}[5m])), 0.001)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Eval-set faithfulness (alert < 0.80)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "prodml_eval_faithfulness",
     "legendFormat": "{{source}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Online faithfulness proxy (mean)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(prodml_faithfulness_proxy_sum[10m]) / clamp_min(rate(prodml_faithfulness_proxy_count[10m]), 0.001)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Query-embedding drift (baseline - rolling cosine)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "prodml_query_drift_drop",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "LLM tokens / hour",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (increase(prodml_llm_tokens_total[1h]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "LLM cost / hour (USD)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(prodml_llm_cost_usd_total[1h])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Guardrail interventions",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (flag) (increase(prodml_guardrail_flags_total[1h]))",
     "legendFormat": "{{flag}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Top retrieval score (p50)",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(prodml_top_score_bucket[10m])) by (le))",
     "legendFormat": ""
    }
   ]
  }
 ]
}